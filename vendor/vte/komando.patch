     /// Handle ground dispatch of print/execute for all characters in a string.
+    ///
+    /// Komando patch: maximal runs of printable ASCII go to
+    /// [`Perform::print_ascii`] in one call; everything else is dispatched one
+    /// character at a time as before.
     #[inline]
     fn ground_dispatch<P: Perform>(performer: &mut P, text: &str) {
-        for c in text.chars() {
+        let bytes = text.as_bytes();
+        let mut i = 0;
+        while i < bytes.len() {
+            let start = i;
+            while i < bytes.len() && is_printable_ascii(bytes[i]) {
+                i += 1;
+            }
+            if i > start {
+                // SAFETY: `start..i` holds only ASCII bytes, so both ends are on
+                // character boundaries.
+                performer.print_ascii(unsafe { text.get_unchecked(start..i) });
+                if i == bytes.len() {
+                    break;
+                }
+            }
+
+            // SAFETY: `i` is on a character boundary: it is either where a run of
+            // ASCII ended or just past the previous whole character.
+            let c = unsafe { text.get_unchecked(i..).chars().next().unwrap_unchecked() };
             match c {
                 '\x00'..='\x1f' | '\u{80}'..='\u{9f}' => performer.execute(c as u8),
                 _ => performer.print(c),
             }
+            i += c.len_utf8();
         }
     }
 }
 
