+    // Komando patch: tests for `Perform::print_ascii`.
+
+    /// Records runs passed to `print_ascii` and, like the default, a `Print`
+    /// for each of their characters.
+    #[derive(Default)]
+    struct RunDispatcher {
+        inner: Dispatcher,
+        runs: Vec<std::string::String>,
+    }
+
+    impl Perform for RunDispatcher {
+        fn osc_dispatch(&mut self, params: &[&[u8]], bell_terminated: bool) {
+            self.inner.osc_dispatch(params, bell_terminated);
+        }
+
+        fn csi_dispatch(&mut self, params: &Params, intermediates: &[u8], ignore: bool, c: char) {
+            self.inner.csi_dispatch(params, intermediates, ignore, c);
+        }
+
+        fn esc_dispatch(&mut self, intermediates: &[u8], ignore: bool, byte: u8) {
+            self.inner.esc_dispatch(intermediates, ignore, byte);
