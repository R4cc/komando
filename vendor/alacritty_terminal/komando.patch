+/// xorshift64*: a small deterministic random number generator.
+struct Rng(u64);
+
+impl Rng {
+    fn next(&mut self) -> u64 {
+        self.0 ^= self.0 >> 12;
+        self.0 ^= self.0 << 25;
+        self.0 ^= self.0 >> 27;
+        self.0.wrapping_mul(0x2545_f491_4f6c_dd1d)
+    }
+
+    fn below(&mut self, n: usize) -> usize {
+        (self.next() % n as u64) as usize
+    }
+
+    fn pick<'a>(&mut self, items: &[&'a str]) -> &'a str {
+        items[self.below(items.len())]
+    }
+}
+
+/// Append a random piece of terminal output, biased towards what `input_ascii` must get right.
+fn token(rng: &mut Rng, columns: usize, lines: usize, out: &mut Vec<u8>) {
+    let n = |rng: &mut Rng, max: usize| rng.below(max + 1);
+    let text: String = match rng.below(40) {
+        // Printable ASCII, often longer than a row.
+        0..=11 => {
+            let len = 1 + rng.below(3 * columns + 2);
+            for _ in 0..len {
+                out.push(0x20 + rng.below(0x5f) as u8);
+            }
+            return;
+        },
+        12 => "\r".into(),
+        13 => "\n".into(),
+        14 => "\r\n".into(),
+        15 => "\x08".into(),
+        16 => "\t".into(),
+        // Wide characters.
+        17 | 18 => rng.pick(&["中", "😀", "ｗ", "中文", "a中"]).into(),
+        // Zero width characters.
+        19 => rng.pick(&["\u{301}", "\u{200d}", "\u{fe0f}"]).into(),
+        // Other one cell wide characters.
+        20 => rng.pick(&["é", "ß", "→", "ä"]).into(),
+        // Charsets: DEC line drawing in G0 or G1, back to ASCII, shift out and in.
+        21 => rng.pick(&["\x1b(0", "\x1b(B", "\x1b)0", "\x1b)B", "\x0e", "\x0f"]).into(),
+        // Insert mode.
+        22 => rng.pick(&["\x1b[4h", "\x1b[4l"]).into(),
+        // Line wrapping (DECAWM).
+        23 => rng.pick(&["\x1b[?7l", "\x1b[?7h"]).into(),
+        // Repeat the preceding character (REP).
+        24 => format!("\x1b[{}b", n(rng, 2 * columns)),
+        // Scroll region.
+        25 => match rng.below(3) {
+            0 => "\x1b[r".into(),
+            _ => format!("\x1b[{};{}r", 1 + n(rng, lines), 1 + n(rng, lines)),
+        },
+        // Origin mode.
+        26 => rng.pick(&["\x1b[?6h", "\x1b[?6l"]).into(),
+        // Cursor position, sometimes past the edges.
+        27 => format!("\x1b[{};{}H", n(rng, lines + 1), n(rng, columns + 1)),
+        // Erase in line or display.
+        28 => format!("\x1b[{}{}", n(rng, 3), rng.pick(&["K", "J"])),
+        // Attributes, including one that gives cells extra storage (underline colour).
+        29 => format!(
+            "\x1b[{}m",
+            rng.pick(&["0", "1", "7", "31", "42", "38;5;99", "48;2;1;2;3", "58;5;3", "59", "4:3"])
+        ),
+        // Hyperlinks (extra storage too).
+        30 => rng.pick(&["\x1b]8;id=a;http://a\x1b\\", "\x1b]8;;\x1b\\"]).into(),
+        // Save and restore the cursor.
+        31 => rng.pick(&["\x1b7", "\x1b8", "\x1b[s", "\x1b[u"]).into(),
+        // Index, reverse index, next line.
+        32 => rng.pick(&["\x1bD", "\x1bM", "\x1bE"]).into(),
+        // Insert and delete lines and characters, erase characters.
+        33 => format!("\x1b[{}{}", n(rng, columns), rng.pick(&["L", "M", "@", "P", "X"])),
+        // Alternate screen.
+        34 => rng.pick(&["\x1b[?1049h", "\x1b[?1049l"]).into(),
+        // DEL, a C1 control in UTF-8, invalid UTF-8.
+        35 => {
+            out.extend_from_slice(match rng.below(3) {
+                0 => b"\x7f",
+                1 => "\u{85}".as_bytes(),
+                _ => b"\xff",
+            });
+            return;
+        },
+        // Cursor movement.
+        36 => format!("\x1b[{}{}", n(rng, columns), rng.pick(&["A", "B", "C", "D", "G", "d"])),
+        // Screen alignment test: fill the screen with E.
+        37 => "\x1b#8".into(),
+        // Scroll up or down.
+        38 => format!("\x1b[{}{}", n(rng, lines), rng.pick(&["S", "T"])),
+        // Full reset, or a single character.
+        _ => rng.pick(&["\x1bc", "a"]).into(),
+    };
+    out.extend_from_slice(text.as_bytes());
+}
