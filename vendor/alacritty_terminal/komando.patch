+#[test]
+fn printable_ascii_is_one_cell_wide() {
+    use unicode_width::UnicodeWidthChar;
+    for byte in 0x20..=0x7eu8 {
+        assert_eq!((byte as char).width(), Some(1), "{byte:#x}");
+    }
+}
