+#[derive(Debug, PartialEq)]
+enum Damage {
+    Full,
+    Lines(Vec<(usize, usize, usize)>),
+}
+
+fn take_damage(term: &mut Term<VoidListener>) -> Damage {
+    let damage = match term.damage() {
+        TermDamage::Full => Damage::Full,
+        TermDamage::Partial(lines) => {
+            Damage::Lines(lines.map(|line| (line.line, line.left, line.right)).collect())
+        },
+    };
+    term.reset_damage();
+    damage
+}
+
+fn assert_same(batched: &Term<VoidListener>, scalar: &Term<VoidListener>, context: &str) {
+    for (a, b, name) in [
+        (&batched.grid, &scalar.grid, "grid"),
+        (&batched.inactive_grid, &scalar.inactive_grid, "inactive grid"),
+    ] {
+        assert_eq!(a.cursor, b.cursor, "{name} cursor: {context}");
+        assert_eq!(a.saved_cursor, b.saved_cursor, "{name} saved cursor: {context}");
+        assert_eq!(a.total_lines(), b.total_lines(), "{name} lines: {context}");
+        assert_eq!(a.display_offset(), b.display_offset(), "{name} offset: {context}");
+        for line in a.topmost_line().0..=a.bottommost_line().0 {
+            let (row_a, row_b) = (&a[Line(line)], &b[Line(line)]);
+            assert_eq!(row_a, row_b, "{name} line {line}: {context}");
+            assert_eq!(row_a.occ, row_b.occ, "{name} line {line} occupied: {context}");
+        }
+    }
+    assert_eq!(batched.mode, scalar.mode, "mode: {context}");
+    assert_eq!(batched.active_charset, scalar.active_charset, "charset: {context}");
+    assert_eq!(batched.scroll_region, scalar.scroll_region, "scroll region: {context}");
+}
+
+/// Feed `chunks` to a terminal through `Term::input_ascii` and to another one character at a
+/// time, and check they are the same after every chunk, damage included.
+///
+/// No terminal here is one column wide: `Term::input` panics on a wide character there, with
+/// or without the patch.
+fn check(columns: usize, lines: usize, history: usize, chunks: &[&[u8]], context: &str) {
+    let size = TermSize::new(columns, lines);
+    let config = || Config { scrolling_history: history, ..Config::default() };
+    let mut batched = Term::new(config(), &size, VoidListener);
+    let mut scalar = Term::new(config(), &size, VoidListener);
+    let mut batched_parser: Processor = Processor::new();
+    let mut scalar_parser: Processor = Processor::new();
+
+    for (i, chunk) in chunks.iter().enumerate() {
+        batched_parser.advance(&mut batched, chunk);
+        scalar_parser.advance(&mut Scalar(&mut scalar), chunk);
+        let context = format!("{context}, after chunk {i} {:?}", String::from_utf8_lossy(chunk));
+        assert_same(&batched, &scalar, &context);
+        assert_eq!(take_damage(&mut batched), take_damage(&mut scalar), "damage: {context}");
+    }
+}
