+#[test]
+fn input_ascii_matches_input_on_tricky_cases() {
+    let cases: &[(&str, &[&str])] = &[
+        ("run wraps at the last column", &["abcdefghijklmnopqrstuvwxyz"]),
+        ("run ends exactly at the last column", &["0123456789", "x"]),
+        ("wrap pending at run start", &["012345678", "9", "abc"]),
+        ("DECAWM off", &["\x1b[?7l", "0123456789abcdef", "gh", "\x1b[?7h", "ij"]),
+        ("DECAWM off, wide char at the end", &["\x1b[?7l", "012345678中", "abc"]),
+        ("insert mode", &["0123456789", "\r\x1b[4h", "abc", "\x1b[4l", "de"]),
+        ("DEC line drawing", &["\x1b(0", "lqqk", "\x1b(B", "lqqk", "\x1b)0\x0e", "xx\x0f", "x"]),
+        ("REP after a run", &["abc\x1b[5b", "\x1b[20b", "x\x1b[b"]),
+        ("REP after a wide char", &["中\x1b[3b", "ab\x1b[2b"]),
+        ("overwrite a wide char", &["中中中中中", "\r", "a", "\x1b[3G", "bc"]),
+        ("overwrite a wide char spacer", &["中中中中中", "\x1b[2G", "a", "\x1b[5G", "bcd"]),
+        ("wide char wrapped with a leading spacer", &["012345678中", "\r", "ab", "\x1bM\r", "x"]),
+        ("leading spacer above", &["012345678中", "\x1b[1G", "q", "\x1b[2G", "r"]),
+        ("split mid escape", &["ab\x1b", "[3", "1mcd", "\x1b[", "0m", "e\x1b]8;id=x;x", "\x1b\\g"]),
+        ("scroll region", &["\x1b[2;3r", "\x1b[3;1H", "0123456789012345678901234567890123"]),
+        ("origin mode", &["\x1b[2;4r\x1b[?6h", "\x1b[3;5H", "0123456789abcdefghijklmnopqrst"]),
+        ("underline colour, hyperlink", &["\x1b[58;5;3mab", "\x1b]8;id=u;u\x1b\\cd", "efghijklm"]),
+        ("zero width after a run", &["abc\u{301}", "0123456789\u{301}"]),
+        ("alternate screen", &["ab\x1b[?1049h", "0123456789abc", "\x1b[?1049l", "de"]),
+    ];
+    let split_utf8: &[&[u8]] = &[b"ab\xe4", b"\xb8", b"\xadcd", b"\xf0\x9f", b"\x98\x80ef"];
+    let cases = cases
+        .iter()
+        .map(|(name, chunks)| (*name, chunks.iter().map(|chunk| chunk.as_bytes()).collect()))
+        .chain([("split mid UTF-8", split_utf8.to_vec())]);
+    for (name, chunks) in cases {
+        for (columns, lines, history) in [(10, 4, 0), (10, 4, 3), (2, 1, 0), (3, 3, 2)] {
+            check(columns, lines, history, &chunks, &format!("{name} ({columns}x{lines})"));
+        }
+    }
+}
+
+#[test]
+fn input_ascii_matches_input_on_random_output() {
+    let mut rng = Rng(0x9e37_79b9_7f4a_7c15);
+    for case in 0..4000 {
+        let columns = [2, 3, 5, 8, 13, 21, 80][rng.below(7)];
+        let lines = [1, 2, 3, 5, 8][rng.below(5)];
+        let history = [0, 3, 50][rng.below(3)];
+        let mut bytes = Vec::new();
+        for _ in 0..1 + rng.below(80) {
+            token(&mut rng, columns, lines, &mut bytes);
+        }
+
+        // Split it anywhere, including inside escapes and UTF-8 sequences.
+        let mut chunks = Vec::new();
+        let mut rest = &bytes[..];
+        while !rest.is_empty() {
+            let len = match rng.below(4) {
+                0 => rest.len(),
+                1 => 1,
+                _ => 1 + rng.below(rest.len().min(40)),
+            };
+            let (chunk, tail) = rest.split_at(len.min(rest.len()));
+            chunks.push(chunk);
+            rest = tail;
+        }
+
+        check(columns, lines, history, &chunks, &format!("case {case} ({columns}x{lines})"));
+    }
+}
+
+#[test]
+fn input_ascii_writes_cells() {
+    // The cells themselves, independent of the scalar path.
+    let mut term = Term::new(Config::default(), &TermSize::new(5, 2), VoidListener);
+    let mut parser: Processor = Processor::new();
+    parser.advance(&mut term, b"\x1b[31mabcdefg");
+    let row0: String = (0..5).map(|column| term.grid[Line(0)][Column(column)].c).collect();
+    let row1: String = (0..2).map(|column| term.grid[Line(1)][Column(column)].c).collect();
+    assert_eq!(row0, "abcde");
+    assert_eq!(row1, "fg");
+    assert!(term.grid[Line(0)][Column(4)].flags.contains(Flags::WRAPLINE));
+    assert_eq!(term.grid[Line(1)][Column(0)].fg, Color::Named(NamedColor::Red));
+    assert_eq!(term.grid.cursor.point.column, Column(2));
+    assert_eq!(term.grid[Line(1)][Column(2)], Cell::default());
+}
diff -ruN a/src/term/mod.rs b/src/term/mod.rs
--- a/src/term/mod.rs
+++ b/src/term/mod.rs
@@ -1137,6 +1137,83 @@
         }
     }
 
+    /// Komando patch: a run of printable ASCII to be displayed.
+    ///
+    /// Does exactly what calling [`Self::input`] for each character would, but
+    /// writes the cells of each row in one tight loop. Every printable ASCII
+    /// character is one cell wide, so there is no width lookup, and the cursor
+    /// template is read once per row rather than per character. Insert mode, a
+    /// charset other than ASCII and cells holding (parts of) wide characters go
+    /// through `input` instead.
+    #[inline(never)]
+    fn input_ascii(&mut self, text: &str) {
+        debug_assert!(text.bytes().all(|b| (0x20..=0x7e).contains(&b)));
+
+        if self.mode.contains(TermMode::INSERT)
+            || self.grid.cursor.charsets[self.active_charset] != StandardCharset::Ascii
+        {
+            for c in text.chars() {
+                self.input(c);
+            }
+            return;
+        }
+
+        let columns = self.columns();
+        let mut bytes = text.as_bytes();
+        while let Some(&last) = bytes.last() {
+            // Move cursor to next line.
+            if self.grid.cursor.input_needs_wrap {
+                self.wrapline();
+
+                // Line wrapping is off: every character left lands on the last column, so
+                // only the last of them is still there afterwards.
+                if self.grid.cursor.input_needs_wrap {
+                    self.write_at_cursor(last as char);
+                    return;
+                }
+            }
+
+            let point = self.grid.cursor.point;
+            let start = point.column.0;
+            let count = bytes.len().min(columns - start);
+
+            let template = &self.grid.cursor.template;
+            let (fg, bg, flags) = (template.fg, template.bg, template.flags);
+            let extra = template.extra.clone();
+
+            // Write cells until one holds part of a wide character: overwriting that takes
+            // clearing up its other half, which `input` does.
+            let mut written = 0;
+            let cells = &mut self.grid[point.line][point.column..Column(start + count)];
