+    /// Komando patch: a session channel with a receive window of its own.
+    pub fn channel_open_session_with_window(
+        &mut self,
+        window: u32,
+    ) -> Result<ChannelId, crate::Error> {
+        self.channel_open_generic_with_window(b"session", Some(window), |_| Ok(()))
+    }
+
+    /// Komando patch: keep `channel`'s receive window topped up to `window` from now on, and
+    /// top it up at once if it is below half of that. A smaller window takes effect as the
+    /// server uses up what it was already allowed: a window can not be taken back.
+    pub fn set_channel_window(
+        &mut self,
+        channel: ChannelId,
+        window: u32,
+    ) -> Result<(), crate::Error> {
+        if let Some(ref mut enc) = self.common.encrypted {
+            if let Some(params) = enc.channels.get_mut(&channel) {
+                params.window_target = Some(window);
+            }
+            enc.adjust_window_size(channel, &[], window)?;
+        }
+        Ok(())
+    }
